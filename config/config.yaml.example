ollama:
  endpoint: "http://YOUR_HOST:11434"
  timeout_seconds: 300
  models:
    router: "qwen2.5:7b"
    knowledge: "ornith:9b"

qdrant:
  endpoint: "http://YOUR_HOST:6333"
  collections:
    knowledge: "rm_knowledge"
    experience: "rm_experience"
  # upsert_batch_size: number of points per BulkUpsert call in Extractor.Run.
  # Increase to reduce round-trips; decrease to reduce per-request memory.
  # Default: 32
  upsert_batch_size: 32
  # timeout_seconds: HTTP client timeout for Qdrant requests.
  # Increase when upserting large batches on a slow network.
  # Default: 30
  timeout_seconds: 30

embedder:
  endpoint: "http://YOUR_HOST:9092"
  api_key: "YOUR_EMBEDDER_API_KEY"
  collection: "rm_knowledge"
  batch_size: 64
  dim: 768

server:
  host: "0.0.0.0"
  port: 8765

scorer:
  alpha: 2.0
  beta: 2.0
  freshness_lambda: 0.01
  task_boost: 1.5
